{
  "schemaVersion": 1,
  "id": "smarthome_appliances",
  "version": "${version}",
  "name": "SmartHome Appliances",
  "description": "A lot of lights, switches and toggles connected wirelessly, to make your home truly smart",
  "authors": [
    "SirEdvin"
  ],
  "accessWidener": "smarthome_appliances.accesswidener",
  "contact": {
    "homepage": "https://example.com/",
    "issues": "https://example.com/",
    "sources": "https://example.com/"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.smarthome.FabricMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.smarthome.FabricModClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.smarthome.data.FabricDataGenerators"
      }
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": ">=0.13.3",
    "fabric": "*",
    "minecraft": ">=1.21 <1.22",
    "java": ">=21",
    "broccolium": ">=${broccoliumVersion}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/dYHKMQYRPp"
      }
    }
  }
}
